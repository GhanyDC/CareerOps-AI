generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceType {
  EMPLOYMENT
  INTERNSHIP
  FREELANCE
  VOLUNTEER
  STUDENT_LEADERSHIP
  ACADEMIC
  INDEPENDENT_WORK
  OTHER
}

enum VerificationStatus {
  DRAFT
  REQUIRES_VERIFICATION
  VERIFIED
  REJECTED
}

enum EvidenceSourceType {
  EXPERIENCE
  PROJECT
}

enum EvidenceStrength {
  DIRECT
  TRANSFERABLE
  SUPPORTING
  WEAK
}

enum ClaimStatus {
  DRAFT
  REQUIRES_VERIFICATION
  APPROVED
  PROHIBITED
  ARCHIVED
}

enum AuditEntityType {
  EVIDENCE
  CLAIM
  DISCOVERY_IMPORT_BATCH
  JOB
  JOB_REQUIREMENT
  JOB_DUPLICATE_CANDIDATE
  JOB_DUPLICATE_GROUP
  JOB_FILTER_PROFILE
  JOB_SCORING_PROFILE
}

enum AuditAction {
  EVIDENCE_RETURNED_TO_DRAFT
  EVIDENCE_VERIFIED
  EVIDENCE_REJECTED
  EVIDENCE_REQUIRES_VERIFICATION
  EVIDENCE_VERIFICATION_REVOKED
  CLAIM_APPROVED
  CLAIM_REQUIRES_VERIFICATION
  CLAIM_PROHIBITED
  CLAIM_ARCHIVED
  CLAIM_APPROVAL_REVOKED
  CLAIM_RETURNED_TO_DRAFT
  DISCOVERY_IMPORT_BATCH_PURGED
  JOB_CREATED_FROM_DISCOVERY
  JOB_UPDATED
  JOB_UPDATED_FROM_PARSE
  JOB_ARCHIVED
  JOB_RESTORED
  JOB_SOURCE_PRIVACY_REDACTED
  JOB_REQUIREMENT_CREATED
  JOB_REQUIREMENT_UPDATED
  JOB_REQUIREMENT_REORDERED
  JOB_REQUIREMENT_ARCHIVED
  JOB_REQUIREMENT_RESTORED
  JOB_REQUIREMENT_EVIDENCE_LINKED
  JOB_REQUIREMENT_EVIDENCE_LINK_UPDATED
  JOB_REQUIREMENT_EVIDENCE_UNLINKED
  JOB_REQUIREMENT_REVIEW_COMPLETED
  JOB_DUPLICATE_DECISION_RECORDED
  JOB_DUPLICATE_GROUP_CHANGED
  JOB_FILTER_PROFILE_CREATED
  JOB_FILTER_PROFILE_UPDATED
  JOB_SCORING_PROFILE_CREATED
  JOB_SCORING_PROFILE_UPDATED
}

enum DiscoveryImportMethod {
  MANUAL_ENTRY
  PASTED_TEXT
  STRUCTURED_JSON
}

enum JobDiscoveryStatus {
  INBOX
  REJECTED
  ARCHIVED
}

enum DiscoveryProcessingEventType {
  BATCH_CONFIRMED
  DISCOVERY_IMPORTED
  DISCOVERY_REJECTED
  DISCOVERY_RESTORED
  DISCOVERY_ARCHIVED
}

enum JobStatus {
  ACTIVE
  ARCHIVED
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  APPRENTICESHIP
  VOLUNTEER
  OTHER
}

enum JobWorkplaceArrangement {
  ON_SITE
  HYBRID
  REMOTE
  FIELD_BASED
  OTHER
}

enum JobExperienceLevel {
  INTERNSHIP
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
  OTHER
}

enum JobSalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
  PROJECT
  OTHER
}

enum JobParseDraftStatus {
  READY_FOR_REVIEW
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum JobSourcePurpose {
  INITIAL_CONFIRMATION
  REPARSE_MERGE
}

enum JobParsingEventType {
  PARSE_DRAFT_CREATED
  PARSE_DRAFT_CORRECTED
  PARSE_DRAFT_REJECTED
  PARSE_DRAFT_SUPERSEDED
  PARSE_DRAFT_CONFIRMED
  JOB_CREATED_FROM_DISCOVERY
  JOB_UPDATED_FROM_PARSE
  PARSE_SOURCE_PRIVACY_REDACTED
}

enum JobDuplicateDecision {
  SAME_OPPORTUNITY
  DIFFERENT_OPPORTUNITIES
  DEFERRED
}

enum JobDuplicateEvidenceTier {
  STRONG
  MODERATE
}

enum JobDuplicateEventType {
  CANDIDATE_CREATED
  CANDIDATE_REEVALUATED
  DUPLICATE_DECISION_RECORDED
  DUPLICATE_DECISION_MARKED_STALE
  DUPLICATE_GROUP_CHANGED
}

enum JobFilterOutcome {
  PASS
  FAIL
  NEEDS_REVIEW
}

enum JobFilterEventType {
  PROFILE_CREATED
  PROFILE_UPDATED
  JOB_EVALUATED
  JOB_REEVALUATED
}

enum JobScoringEventType {
  PROFILE_CREATED
  PROFILE_UPDATED
  JOB_SCORED
  JOB_RESCORED
}

enum JobRequirementCategory {
  SKILL
  EXPERIENCE
  EDUCATION
  CERTIFICATION
  RESPONSIBILITY
  DOMAIN_KNOWLEDGE
  OTHER
}

enum JobRequirementImportance {
  REQUIRED
  PREFERRED
  OTHER
}

enum JobRequirementSource {
  MANUAL
  JOB_RESPONSIBILITY
  JOB_QUALIFICATION
  JOB_PREFERRED_QUALIFICATION
  JOB_SKILL
}

enum JobRequirementState {
  ACTIVE
  ARCHIVED
}

enum JobRequirementSupportLevel {
  FULL
  PARTIAL
}

enum JobRequirementMatchStatus {
  NOT_REVIEWED
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
}

enum JobRequirementMatchEventType {
  REQUIREMENT_CREATED
  REQUIREMENT_UPDATED
  REQUIREMENT_REORDERED
  REQUIREMENT_ARCHIVED
  REQUIREMENT_RESTORED
  EVIDENCE_LINKED
  EVIDENCE_LINK_UPDATED
  EVIDENCE_UNLINKED
  EVIDENCE_VERSION_CHANGED
  REVIEW_COMPLETED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthenticationAuditAction {
  USER_CREATED_FROM_PROVIDER
  SIGN_IN_SUCCEEDED
  SIGN_OUT
  PROVIDER_ACCOUNT_LINKED
  PROVIDER_ACCOUNT_UNLINKED
  SESSION_REVOKED
  ALL_SESSIONS_REVOKED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_SOFT_DELETED
  DEVELOPMENT_USER_LINKED
}

model User {
  id                String     @id @default(cuid())
  developmentKey    String?    @unique @db.VarChar(100)
  authName          String?    @db.VarChar(160)
  authEmail         String?    @unique @db.VarChar(320)
  authEmailVerified Boolean    @default(false)
  authImage         String?    @db.VarChar(2048)
  status            UserStatus @default(ACTIVE)
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  candidateProfile            CandidateProfile?
  experiences                 Experience[]
  projects                    Project[]
  evidenceItems               EvidenceItem[]
  claims                      Claim[]
  auditLogs                   AuditLog[]
  authAccounts                AuthAccount[]
  authSessions                AuthSession[]
  authenticationAuditLogs     AuthenticationAuditLog[]
  discoveryImportBatches      DiscoveryImportBatch[]
  jobDiscoveries              JobDiscovery[]
  discoveryProcessingEvents   DiscoveryProcessingEvent[]
  jobs                        Job[]
  jobParseDrafts              JobParseDraft[]
  jobSources                  JobSource[]
  jobParsingEvents            JobParsingEvent[]
  jobCanonicalRepresentations JobCanonicalRepresentation[]
  jobDuplicateCandidates      JobDuplicateCandidate[]
  jobDuplicateGroups          JobDuplicateGroup[]
  jobDuplicateGroupMembers    JobDuplicateGroupMember[]
  jobDuplicateEvents          JobDuplicateEvent[]
  jobFilterProfile            JobFilterProfile?
  jobFilterEvaluations        JobFilterEvaluation[]
  jobFilterEvents             JobFilterEvent[]
  jobScoringProfile           JobScoringProfile?
  jobPreliminaryScores        JobPreliminaryScore[]
  jobScoringEvents            JobScoringEvent[]
  jobRequirements             JobRequirement[]
  jobRequirementEvidenceLinks JobRequirementEvidenceLink[]
  jobRequirementReviews       JobRequirementReview[]
  jobRequirementMatchEvents   JobRequirementMatchEvent[]
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(80)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model AuthenticationAuditLog {
  id            String                    @id @default(cuid())
  userId        String
  authAccountId String?
  authSessionId String?
  action        AuthenticationAuditAction
  providerId    String?                   @db.VarChar(80)
  reasonCode    String?                   @db.VarChar(80)
  createdAt     DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model CandidateProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  fullName                 String?  @db.VarChar(160)
  professionalHeadline     String?  @db.VarChar(240)
  careerSummary            String?  @db.Text
  preferredRoleFamilies    String[] @default([])
  preferredLocations       String[] @default([])
  acceptedWorkArrangements String[] @default([])
  acceptedEmploymentTypes  String[] @default([])
  schedulePreferences      String[] @default([])
  nightShiftAcceptance     Boolean?
  relocationPreference     String?  @db.VarChar(160)
  salaryCurrency           String?  @db.VarChar(3)
  salaryMinimum            Decimal? @db.Decimal(12, 2)
  salaryNotes              String?  @db.Text
  careerGoals              String?  @db.Text
  dostReturnServiceNotes   String?  @db.Text
  applicationPreferences   String?  @db.Text
  hardExclusions           String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]
  projects    Project[]

  @@unique([id, userId])
}

model Experience {
  id                 String             @id @default(cuid())
  userId             String
  candidateProfileId String
  title              String             @db.VarChar(200)
  organization       String?            @db.VarChar(200)
  experienceType     ExperienceType
  location           String?            @db.VarChar(200)
  workSetup          String?            @db.VarChar(80)
  startDate          DateTime?          @db.Date
  endDate            DateTime?          @db.Date
  currentlyActive    Boolean            @default(false)
  summary            String?            @db.Text
  responsibilities   String[]           @default([])
  technologies       String[]           @default([])
  skills             String[]           @default([])
  outcomes           String[]           @default([])
  sourceNotes        String?            @db.Text
  verificationStatus VerificationStatus @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId, userId], references: [id, userId], onDelete: Cascade)
  evidenceItems    EvidenceItem[]   @relation("ExperienceEvidence")

  @@unique([id, userId])
  @@index([userId, experienceType])
  @@index([userId, verificationStatus])
  @@index([candidateProfileId])
}

model Project {
  id                   String             @id @default(cuid())
  userId               String
  candidateProfileId   String
  name                 String             @db.VarChar(200)
  shortDescription     String?            @db.VarChar(500)
  problemAddressed     String?            @db.Text
  candidateRole        String?            @db.VarChar(200)
  responsibilities     String[]           @default([])
  technologies         String[]           @default([])
  skills               String[]           @default([])
  challenges           String[]           @default([])
  actionsTaken         String[]           @default([])
  outcomes             String[]           @default([])
  quantifiedResults    String[]           @default([])
  relevantRoleFamilies String[]           @default([])
  projectUrl           String?            @db.VarChar(2048)
  repositoryUrl        String?            @db.VarChar(2048)
  startDate            DateTime?          @db.Date
  endDate              DateTime?          @db.Date
  verificationStatus   VerificationStatus @default(DRAFT)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId, userId], references: [id, userId], onDelete: Cascade)
  evidenceItems    EvidenceItem[]   @relation("ProjectEvidence")

  @@unique([id, userId])
  @@index([userId, verificationStatus])
  @@index([candidateProfileId])
}

model EvidenceItem {
  id                          String             @id @default(cuid())
  userId                      String
  sourceType                  EvidenceSourceType
  sourceExperienceId          String?
  sourceProjectId             String?
  claim                       String             @db.VarChar(1000)
  supportingContext           String?            @db.Text
  skillsDemonstrated          String[]           @default([])
  relevantRoleFamilies        String[]           @default([])
  evidenceStrength            EvidenceStrength
  verificationStatus          VerificationStatus @default(DRAFT)
  allowedForResume            Boolean            @default(false)
  allowedForCoverLetters      Boolean            @default(false)
  allowedForInterviews        Boolean            @default(false)
  allowedForRecruiterMessages Boolean            @default(false)
  sourceNotes                 String?            @db.Text
  version                     Int                @default(1)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceExperience Experience? @relation("ExperienceEvidence", fields: [sourceExperienceId, userId], references: [id, userId], onDelete: Restrict)
  sourceProject    Project?    @relation("ProjectEvidence", fields: [sourceProjectId, userId], references: [id, userId], onDelete: Restrict)
  claims           Claim[]
  requirementLinks JobRequirementEvidenceLink[]

  @@unique([id, userId])
  @@index([userId, verificationStatus])
  @@index([userId, evidenceStrength])
  @@index([sourceExperienceId])
  @@index([sourceProjectId])
}

model Claim {
  id                          String      @id @default(cuid())
  userId                      String
  evidenceItemId              String?
  claimText                   String      @db.VarChar(1000)
  status                      ClaimStatus @default(DRAFT)
  reviewerNotes               String?     @db.Text
  allowedForResume            Boolean     @default(false)
  allowedForCoverLetters      Boolean     @default(false)
  allowedForInterviews        Boolean     @default(false)
  allowedForRecruiterMessages Boolean     @default(false)
  approvedAt                  DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceItem EvidenceItem? @relation(fields: [evidenceItemId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, status])
  @@index([evidenceItemId])
}

model AuditLog {
  id            String          @id @default(cuid())
  userId        String
  entityType    AuditEntityType
  entityId      String
  action        AuditAction
  previousState Json?
  newState      Json?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model DiscoveryImportBatch {
  id                String                @id @default(cuid())
  userId            String
  importMethod      DiscoveryImportMethod
  producerLabel     String                @db.VarChar(160)
  contractVersion   Int                   @default(1)
  originalPayload   String                @db.Text
  validationSummary Json
  idempotencyKey    String                @db.Uuid
  payloadHash       String                @db.Char(64)
  confirmedAt       DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveries      JobDiscovery[]
  processingEvents DiscoveryProcessingEvent[]

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([userId, confirmedAt, id])
}

model JobDiscovery {
  id                String             @id @default(cuid())
  userId            String
  batchId           String
  status            JobDiscoveryStatus @default(INBOX)
  sourceLabel       String?            @db.VarChar(160)
  submittedUrl      String?            @db.VarChar(2048)
  titleHint         String?            @db.VarChar(200)
  companyHint       String?            @db.VarChar(200)
  locationHint      String?            @db.VarChar(200)
  discoveredAt      DateTime?
  rawContent        String             @db.Text
  validationSummary Json
  version           Int                @default(1)
  rejectedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch            DiscoveryImportBatch       @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade)
  processingEvents DiscoveryProcessingEvent[]
  parseDrafts      JobParseDraft[]            @relation("DraftDiscovery")
  jobSources       JobSource[]                @relation("SourceDiscovery")

  @@unique([id, userId])
  @@unique([id, batchId, userId])
  @@index([batchId, userId])
  @@index([userId, createdAt, id])
  @@index([userId, status, createdAt, id])
  @@index([userId, sourceLabel, createdAt, id])
}

model DiscoveryProcessingEvent {
  id             String                       @id @default(cuid())
  userId         String
  batchId        String
  discoveryId    String?
  eventType      DiscoveryProcessingEventType
  previousStatus JobDiscoveryStatus?
  newStatus      JobDiscoveryStatus?
  safeMetadata   Json?
  createdAt      DateTime                     @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch     DiscoveryImportBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade)
  discovery JobDiscovery?        @relation(fields: [discoveryId, batchId, userId], references: [id, batchId, userId], onDelete: Cascade)

  @@index([userId, batchId, createdAt])
  @@index([userId, discoveryId, createdAt])
}

model Job {
  id                      String                   @id @default(cuid())
  userId                  String
  title                   String                   @db.VarChar(200)
  companyName             String?                  @db.VarChar(200)
  employmentType          JobEmploymentType?
  workplaceArrangement    JobWorkplaceArrangement?
  experienceLevel         JobExperienceLevel?
  countryCode             String?                  @db.VarChar(2)
  region                  String?                  @db.VarChar(160)
  city                    String?                  @db.VarChar(160)
  locationLabel           String?                  @db.VarChar(300)
  salaryMin               Decimal?                 @db.Decimal(14, 2)
  salaryMax               Decimal?                 @db.Decimal(14, 2)
  salaryCurrency          String?                  @db.VarChar(3)
  salaryPeriod            JobSalaryPeriod?
  postedAt                DateTime?                @db.Date
  closesAt                DateTime?                @db.Date
  sourceUrl               String?                  @db.VarChar(2048)
  description             String?                  @db.Text
  responsibilities        String[]                 @default([])
  qualifications          String[]                 @default([])
  preferredQualifications String[]                 @default([])
  benefits                String[]                 @default([])
  skills                  String[]                 @default([])
  applicationInstructions String?                  @db.Text
  contactDetails          String?                  @db.Text
  notes                   String?                  @db.Text
  fieldProvenance         Json
  status                  JobStatus                @default(ACTIVE)
  version                 Int                      @default(1)
  confirmedAt             DateTime                 @default(now())
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources                  JobSource[]
  reparseDrafts            JobParseDraft[]             @relation("ReparseTarget")
  parsingEvents            JobParsingEvent[]
  canonicalRepresentation  JobCanonicalRepresentation?
  duplicateCandidatesAsA   JobDuplicateCandidate[]     @relation("DuplicateCandidateJobA")
  duplicateCandidatesAsB   JobDuplicateCandidate[]     @relation("DuplicateCandidateJobB")
  primaryDuplicateGroups   JobDuplicateGroup[]         @relation("DuplicateGroupPrimary")
  duplicateGroupMembership JobDuplicateGroupMember?
  filterEvaluation         JobFilterEvaluation?
  filterEvents             JobFilterEvent[]
  preliminaryScore         JobPreliminaryScore?
  scoringEvents            JobScoringEvent[]
  requirements             JobRequirement[]
  requirementMatchEvents   JobRequirementMatchEvent[]

  @@unique([id, userId])
  @@index([userId, status, confirmedAt, id])
  @@index([userId, employmentType, confirmedAt, id])
  @@index([userId, workplaceArrangement, confirmedAt, id])
}

model JobParseDraft {
  id                 String              @id @default(cuid())
  userId             String
  discoveryId        String?
  batchId            String?
  sourceDiscoveryRef String              @db.VarChar(100)
  sourceBatchRef     String              @db.VarChar(100)
  targetJobId        String?
  baseJobVersion     Int?
  parserVersion      String              @db.VarChar(64)
  contractVersion    Int                 @default(1)
  sourcePayloadHash  String              @db.Char(64)
  parsedPayload      Json
  validationSummary  Json
  fieldProvenance    Json
  status             JobParseDraftStatus @default(READY_FOR_REVIEW)
  userCorrections    Json
  version            Int                 @default(1)
  confirmedAt        DateTime?
  rejectedAt         DateTime?
  supersededAt       DateTime?
  contentPurgedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery JobDiscovery?     @relation("DraftDiscovery", fields: [discoveryId, batchId, userId], references: [id, batchId, userId], onDelete: Restrict)
  targetJob Job?              @relation("ReparseTarget", fields: [targetJobId, userId], references: [id, userId], onDelete: Restrict)
  source    JobSource?
  events    JobParsingEvent[]

  @@unique([id, userId])
  @@unique([id, sourceDiscoveryRef, sourceBatchRef, userId])
  @@index([userId, discoveryId, status])
  @@index([userId, status, updatedAt, id])
  @@index([userId, targetJobId, status])
}

model JobSource {
  id                 String           @id @default(cuid())
  userId             String
  jobId              String
  discoveryId        String?
  batchId            String?
  sourceDiscoveryRef String           @db.VarChar(100)
  sourceBatchRef     String           @db.VarChar(100)
  parseDraftId       String           @unique
  purpose            JobSourcePurpose
  sourcePayloadHash  String           @db.Char(64)
  parserVersion      String           @db.VarChar(64)
  contractVersion    Int
  appliedFields      String[]         @default([])
  confirmedByUserId  String
  idempotencyKey     String           @db.Uuid
  confirmationHash   String           @db.Char(64)
  confirmedAt        DateTime         @default(now())
  sourcePurgedAt     DateTime?
  createdAt          DateTime         @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job           @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  discovery  JobDiscovery? @relation("SourceDiscovery", fields: [discoveryId, batchId, userId], references: [id, batchId, userId], onDelete: Restrict)
  parseDraft JobParseDraft @relation(fields: [parseDraftId, sourceDiscoveryRef, sourceBatchRef, userId], references: [id, sourceDiscoveryRef, sourceBatchRef, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@unique([parseDraftId, sourceDiscoveryRef, sourceBatchRef, userId])
  @@index([userId, jobId, confirmedAt])
  @@index([userId, discoveryId, confirmedAt])
}

model JobParsingEvent {
  id             String               @id @default(cuid())
  userId         String
  parseDraftId   String
  jobId          String?
  eventType      JobParsingEventType
  previousStatus JobParseDraftStatus?
  newStatus      JobParseDraftStatus?
  safeMetadata   Json
  createdAt      DateTime             @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parseDraft JobParseDraft @relation(fields: [parseDraftId, userId], references: [id, userId], onDelete: Cascade)
  job        Job?          @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, parseDraftId, createdAt])
  @@index([userId, jobId, createdAt])
  @@index([userId, eventType, createdAt])
}

model JobCanonicalRepresentation {
  id                           String                   @id @default(cuid())
  userId                       String
  jobId                        String
  canonicalizationVersion      Int                      @default(1)
  urlCanonicalizationVersion   Int                      @default(1)
  sourceJobVersion             Int
  canonicalTitle               String                   @db.VarChar(200)
  canonicalCompanyName         String?                  @db.VarChar(200)
  employmentType               JobEmploymentType?
  workplaceArrangement         JobWorkplaceArrangement?
  experienceLevel              JobExperienceLevel?
  countryCode                  String?                  @db.VarChar(2)
  canonicalRegion              String?                  @db.VarChar(160)
  canonicalCity                String?                  @db.VarChar(160)
  canonicalLocationLabel       String?                  @db.VarChar(300)
  salaryMin                    Decimal?                 @db.Decimal(14, 2)
  salaryMax                    Decimal?                 @db.Decimal(14, 2)
  salaryCurrency               String?                  @db.VarChar(3)
  salaryPeriod                 JobSalaryPeriod?
  postedAt                     DateTime?                @db.Date
  closesAt                     DateTime?                @db.Date
  canonicalSourceUrl           String?                  @db.VarChar(2048)
  canonicalSourceUrlHash       String?                  @db.Char(64)
  companyTitleHash             String?                  @db.Char(64)
  companyTitleLocationHash     String?                  @db.Char(64)
  descriptionFingerprint       String?                  @db.Char(64)
  responsibilitiesFingerprint  String?                  @db.Char(64)
  qualificationsFingerprint    String?                  @db.Char(64)
  skillsFingerprint            String?                  @db.Char(64)
  structuredContentFingerprint String?                  @db.Char(64)
  comparisonHash               String                   @db.Char(64)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId, canonicalSourceUrlHash])
  @@index([userId, companyTitleHash])
  @@index([userId, companyTitleLocationHash])
  @@index([userId, sourceJobVersion])
}

model JobDuplicateCandidate {
  id                              String                   @id @default(cuid())
  userId                          String
  jobAId                          String
  jobBId                          String
  activeCandidate                 Boolean                  @default(true)
  evidenceTier                    JobDuplicateEvidenceTier
  ruleSetVersion                  Int                      @default(1)
  canonicalizationVersion         Int                      @default(1)
  jobARepresentationHash          String                   @db.Char(64)
  jobBRepresentationHash          String                   @db.Char(64)
  evidence                        Json
  conflicts                       Json
  decision                        JobDuplicateDecision?
  decisionActorUserId             String?
  decisionAt                      DateTime?
  decisionRuleSetVersion          Int?
  decisionCanonicalizationVersion Int?
  decisionJobAVersion             Int?
  decisionJobBVersion             Int?
  decisionNeedsReview             Boolean                  @default(false)
  decisionStaleAt                 DateTime?
  evaluatedAt                     DateTime                 @default(now())
  version                         Int                      @default(1)
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobA   Job                 @relation("DuplicateCandidateJobA", fields: [jobAId, userId], references: [id, userId], onDelete: Restrict)
  jobB   Job                 @relation("DuplicateCandidateJobB", fields: [jobBId, userId], references: [id, userId], onDelete: Restrict)
  events JobDuplicateEvent[]

  @@unique([id, userId])
  @@unique([userId, jobAId, jobBId])
  @@index([userId, activeCandidate, decisionNeedsReview, updatedAt, id])
  @@index([userId, decision, updatedAt, id])
  @@index([userId, jobAId])
  @@index([userId, jobBId])
}

model JobDuplicateGroup {
  id           String   @id @default(cuid())
  userId       String
  primaryJobId String
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryJob        Job                       @relation("DuplicateGroupPrimary", fields: [primaryJobId, userId], references: [id, userId], onDelete: Restrict)
  primaryMembership JobDuplicateGroupMember   @relation("DuplicateGroupPrimaryMembership", fields: [id, primaryJobId, userId], references: [groupId, jobId, userId], onDelete: NoAction)
  members           JobDuplicateGroupMember[] @relation("DuplicateGroupMembers")

  @@unique([id, userId])
  @@unique([id, primaryJobId, userId])
  @@index([userId, updatedAt, id])
  @@index([userId, primaryJobId])
}

model JobDuplicateGroupMember {
  groupId   String
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           JobDuplicateGroup  @relation("DuplicateGroupMembers", fields: [groupId, userId], references: [id, userId], onDelete: Cascade)
  primaryForGroup JobDuplicateGroup? @relation("DuplicateGroupPrimaryMembership")
  job             Job                @relation(fields: [jobId, userId], references: [id, userId], onDelete: Restrict)

  @@id([groupId, jobId])
  @@unique([groupId, jobId, userId])
  @@unique([jobId, userId])
  @@index([userId, groupId])
}

model JobDuplicateEvent {
  id               String                @id @default(cuid())
  userId           String
  candidateId      String?
  eventType        JobDuplicateEventType
  actorUserId      String?
  idempotencyKey   String?               @db.Uuid
  requestHash      String?               @db.Char(64)
  previousDecision JobDuplicateDecision?
  newDecision      JobDuplicateDecision?
  safeMetadata     Json
  createdAt        DateTime              @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate JobDuplicateCandidate? @relation(fields: [candidateId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, candidateId, createdAt])
  @@index([userId, eventType, createdAt])
}

model JobFilterProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  configuration     Json
  configurationHash String   @db.Char(64)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations JobFilterEvaluation[]
  events      JobFilterEvent[]

  @@unique([id, userId])
}

model JobFilterEvaluation {
  id                   String           @id @default(cuid())
  userId               String
  profileId            String
  jobId                String
  outcome              JobFilterOutcome
  ruleSetVersion       Int
  filterProfileVersion Int
  configurationHash    String           @db.Char(64)
  sourceJobVersion     Int
  explanation          Json
  explanationHash      String           @db.Char(64)
  evaluatedAt          DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile JobFilterProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  job     Job              @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([jobId, userId])
  @@index([userId, outcome, updatedAt, id])
  @@index([userId, filterProfileVersion, outcome])
}

model JobFilterEvent {
  id                   String             @id @default(cuid())
  userId               String
  profileId            String
  jobId                String?
  eventType            JobFilterEventType
  actorUserId          String?
  previousOutcome      JobFilterOutcome?
  newOutcome           JobFilterOutcome?
  filterProfileVersion Int
  sourceJobVersion     Int?
  safeMetadata         Json
  createdAt            DateTime           @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile JobFilterProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  job     Job?             @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, profileId, createdAt])
  @@index([userId, jobId, createdAt])
}

model JobScoringProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  configuration     Json
  configurationHash String   @db.Char(64)
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores JobPreliminaryScore[]
  events JobScoringEvent[]

  @@unique([id, userId])
}

model JobPreliminaryScore {
  id                    String   @id @default(cuid())
  userId                String
  profileId             String
  jobId                 String
  score                 Int
  coverage              Int
  ruleSetVersion        Int
  scoringProfileVersion Int
  configurationHash     String   @db.Char(64)
  sourceJobVersion      Int
  explanation           Json
  explanationHash       String   @db.Char(64)
  scoredAt              DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile JobScoringProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  job     Job               @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([jobId, userId])
  @@index([userId, score, coverage, updatedAt, id])
  @@index([userId, scoringProfileVersion, score])
}

model JobScoringEvent {
  id                    String              @id @default(cuid())
  userId                String
  profileId             String
  jobId                 String?
  eventType             JobScoringEventType
  actorUserId           String?
  previousScore         Int?
  newScore              Int?
  previousCoverage      Int?
  newCoverage           Int?
  scoringProfileVersion Int
  sourceJobVersion      Int?
  safeMetadata          Json
  createdAt             DateTime            @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile JobScoringProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
  job     Job?              @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, profileId, createdAt])
  @@index([userId, jobId, createdAt])
}

model JobRequirement {
  id              String                   @id @default(cuid())
  userId          String
  jobId           String
  statement       String                   @db.VarChar(1000)
  category        JobRequirementCategory
  importance      JobRequirementImportance
  position        Int
  version         Int                      @default(1)
  matchSetVersion Int                      @default(1)
  source          JobRequirementSource
  state           JobRequirementState      @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job                          @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  evidenceLinks JobRequirementEvidenceLink[]
  review        JobRequirementReview?
  events        JobRequirementMatchEvent[]

  @@unique([id, userId])
  @@unique([id, jobId, userId])
  @@index([userId, jobId, state, position, id])
  @@index([userId, importance, state, updatedAt, id])
}

model JobRequirementEvidenceLink {
  id                      String                     @id @default(cuid())
  userId                  String
  requirementId           String
  evidenceItemId          String
  supportLevel            JobRequirementSupportLevel
  rationale               String?                    @db.VarChar(500)
  position                Int
  version                 Int                        @default(1)
  reviewedEvidenceVersion Int?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement JobRequirement @relation(fields: [requirementId, userId], references: [id, userId], onDelete: Cascade)
  evidence    EvidenceItem   @relation(fields: [evidenceItemId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([requirementId, evidenceItemId])
  @@index([userId, requirementId, position, id])
  @@index([userId, evidenceItemId, requirementId])
}

model JobRequirementReview {
  id                      String                    @id @default(cuid())
  userId                  String
  requirementId           String
  status                  JobRequirementMatchStatus
  reviewedRequirementVersion Int
  reviewedMatchSetVersion Int
  matchSchemaVersion      Int
  linkSetHash             String                    @db.Char(64)
  version                 Int                       @default(1)
  reviewedAt              DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement JobRequirement @relation(fields: [requirementId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([requirementId, userId])
  @@index([userId, status, reviewedAt, id])
}

model JobRequirementMatchEvent {
  id                 String                       @id @default(cuid())
  userId             String
  jobId              String
  requirementId      String
  eventType          JobRequirementMatchEventType
  actorUserId        String?
  requirementVersion Int
  matchSetVersion    Int
  evidenceItemId     String?
  evidenceVersion    Int?
  supportLevel       JobRequirementSupportLevel?
  reviewStatus       JobRequirementMatchStatus?
  safeMetadata       Json
  createdAt          DateTime                     @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job            @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  requirement JobRequirement @relation(fields: [requirementId, jobId, userId], references: [id, jobId, userId], onDelete: Cascade)

  @@index([userId, jobId, createdAt])
  @@index([userId, requirementId, createdAt])
  @@index([userId, eventType, createdAt])
}
