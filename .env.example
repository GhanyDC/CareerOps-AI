NODE_ENV=development

# Server-only authentication configuration. Replace every placeholder before running the app.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://127.0.0.1:3000
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
# Do not set BETTER_AUTH_TRUSTED_ORIGINS. CareerOps rejects Better Auth's secondary origin variable.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Server-only Grounded Retrieval configuration. Lexical retrieval works while disabled.
CAREEROPS_EMBEDDING_PROVIDER=disabled
CAREEROPS_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=replace-with-server-only-openai-api-key

# Local development seed only. This is not an authentication bypass.
DEVELOPMENT_SEED_ENABLED=true
DEVELOPMENT_USER_KEY=careerops-local-development

POSTGRES_DB=careerops
POSTGRES_USER=careerops
POSTGRES_PASSWORD=careerops_local_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://careerops:careerops_local_only@localhost:55432/careerops?schema=public
